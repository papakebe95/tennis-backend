DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tennis_dev?schema=public"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PORT=3000

# Comma-separated browser origins allowed to call the API with credentials
# (the back-office). Unset = any origin, without cookies.
CORS_ORIGINS=http://localhost:4200
# Country code assumed when a phone number is typed without one (login).
DEFAULT_CALLING_CODE=221
# Set to 1 when running behind one reverse proxy (Railway).
TRUST_PROXY=

# Cloudflare R2 (S3-compatible) - image uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
